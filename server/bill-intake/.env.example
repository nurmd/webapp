# Provider keys — keep this file out of git
EXTRACTION_PROVIDER=gemini

# Gemini (default)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (or any Responses-API-compatible gateway / local vLLM)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_BASE_URL=https://api.openai.com/v1

# Shared secret the app sends as "Authorization: Bearer <token>"
INTAKE_TOKEN=change-me-before-deploy

# Comma-separated origins, or * during local development
ALLOWED_ORIGINS=*

PORT=8787
RATE_LIMIT_PER_WINDOW=60
